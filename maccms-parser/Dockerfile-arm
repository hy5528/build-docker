# 使用官方 Python 映像檔作為基礎
FROM python:3.11-alpine

# 安装 ARMv7 架构下编译 C/C++ 扩展必需的系统依赖
RUN apk add --no-cache \
    build-base \
    linux-headers \
    libffi-dev 



# 設定工作目錄
WORKDIR /app

# 升级基础构建工具链，避免 setuptools/wheel 版本不兼容导致的编译失败
RUN pip install --upgrade pip setuptools wheel

# 複製依賴檔案並安裝
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt


# 複製專案所有檔案到工作目錄
COPY . .

# 宣告資料 Volume
VOLUME /app/data

# 宣告容器對外的連接埠
EXPOSE 5000

CMD ["gunicorn", \
     "--worker-class", "sync", \
     "--workers", "2", \
     "--timeout", "120", \
     "--graceful-timeout", "25", \
     "--max-requests", "800", \
     "--max-requests-jitter", "80", \
     "--keep-alive", "4", \
     "--preload", \
     "--bind", "0.0.0.0:5000", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "web_app:app"]
